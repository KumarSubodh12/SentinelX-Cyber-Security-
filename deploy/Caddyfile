# Caddy gets and renews the HTTPS certificate for $DOMAIN by itself (Let's Encrypt).
# With DOMAIN=localhost it uses a local self-signed certificate, which is handy for testing.

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# API, agent log ingestion and the live WebSocket go to the backend.
	@backend path /api/* /ws
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the web app.
	handle {
		reverse_proxy frontend:3000
	}
}
