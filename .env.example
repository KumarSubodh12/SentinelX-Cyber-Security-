# SentinelX configuration.
# Copy this file to ".env" in the project root and edit it:   cp .env.example .env
# The same file is read by the backend (VS Code / python), by docker compose, and by the production stack.
# Never commit your real .env file. It is listed in .gitignore.

# --------------------------------------------------------------------------------------------------
# 1. Required for production (the backend refuses to start in production with the placeholders below)
# --------------------------------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# Signs login tokens. Use at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-0123456789

# The first admin account is created on the first start (only when no users exist yet).
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@sentinelx.local
FIRST_ADMIN_PASSWORD=ChangeMe-Now-123!

# Database.
#  - Local run without Docker: SQLite is fine for trying things out.
#  - Production: PostgreSQL only. docker compose builds this URL for you from POSTGRES_PASSWORD below.
DATABASE_URL=sqlite:///./sentinelx.db
POSTGRES_PASSWORD=change-this-database-password

# --------------------------------------------------------------------------------------------------
# 2. Production stack only (docker-compose.prod.yml with Caddy and automatic HTTPS)
# --------------------------------------------------------------------------------------------------

# Your public domain name. Its DNS A/AAAA record must point at this server before the first start.
# "localhost" lets you test the production stack on your own computer with a self-signed certificate.
DOMAIN=localhost

# --------------------------------------------------------------------------------------------------
# 3. Optional
# --------------------------------------------------------------------------------------------------

# Browser origins allowed to call the API (comma-separated). Only needed when the web app and the API
# are on DIFFERENT addresses, such as local development (3000 and 8000) or Render.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Turn on only when the API runs behind your own reverse proxy (Caddy, nginx, Render). The production
# compose file and render.yaml already set it. Leave it false when the API is reachable directly,
# otherwise anyone could fake their IP address with an X-Forwarded-For header.
TRUST_PROXY_HEADERS=false

# Interactive API documentation at /api/docs. Turn off in production.
ENABLE_DOCS=true

# The built-in attack simulator (test data labelled SIM). Set to false once you only want real data.
ENABLE_SIMULATOR=true

# Login tokens last this many minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Failed sign-in attempts allowed per IP address inside the window, before it is blocked for a while.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Detection tuning.
# Offset from UTC in minutes for "unusual hour" detection. 330 = India (UTC+5:30), 0 = UTC.
BUSINESS_TZ_OFFSET_MINUTES=330
# The same detection from the same source updates one alert instead of creating many (seconds).
ALERT_COOLDOWN_SECONDS=3600
# Alerts at or above this severity open an incident automatically: critical | high | medium | low
AUTO_INCIDENT_MIN_SEVERITY=high

# Anomaly model (Isolation Forest).
ML_ENABLED=true
ML_MIN_TRAIN_SAMPLES=200
ML_RETRAIN_HOURS=24
ML_TRAIN_DAYS=30

# Threat intelligence (both optional).
# Free key from https://www.abuseipdb.com/account/api . Enables IP reputation lookups.
ABUSEIPDB_API_KEY=
# Comma-separated URLs of plain-text lists with one IP or CIDR per line (blocklists).
THREAT_FEED_URLS=
THREAT_FEED_REFRESH_HOURS=6

# Notifications. Alerts at or above NOTIFY_MIN_SEVERITY are posted as JSON to this https:// address
# (Slack and Discord incoming webhooks work). You can also set these inside the app under Settings.
ALERT_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=high

# Events older than this many days are deleted every night.
RETENTION_DAYS=90
