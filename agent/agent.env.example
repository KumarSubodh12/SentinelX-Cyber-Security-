# SentinelX agent configuration. Copy to agent.env and edit.

# --- Required ---------------------------------------------------------------
# Server address. Use https:// for anything that is not on this machine.
SENTINELX_URL=http://localhost:8000
# Create an agent in the dashboard: Settings > Agents > New agent. The key is shown once.
SENTINELX_API_KEY=sx_paste_your_agent_key_here

# --- Identity / storage -----------------------------------------------------------
# AGENT_HOSTNAME=web-01
STATE_DIR=./state

# --- Linux authentication logs (SSH logins, sudo, new users) ------------------
# auto = /var/log/auth.log or /var/log/secure if present, otherwise the systemd journal
LINUX_AUTH_MODE=auto
# LINUX_AUTH_LOG=/var/log/auth.log

# --- Web server access logs (nginx / Apache "combined" format), comma separated -
# WEB_ACCESS_LOGS=/var/log/nginx/access.log
# POST requests to these paths become login events (401/403 = failed, 301/302/303 = success)
# WEB_LOGIN_PATHS=/login,/api/auth/login,/wp-login.php

# --- Firewall logs (UFW / iptables LOG rules), comma separated --------------------
# FIREWALL_LOGS=/var/log/ufw.log
# FIREWALL_MARKERS=UFW BLOCK,IPTABLES-DROP

# --- Windows (used only when the agent runs on Windows; needs Administrator) -------
WINDOWS_SECURITY=true
# WINDOWS_LOGON_TYPES=2,3,7,10,11

# --- Tuning -------------------------------------------------------------------------
# BATCH_SIZE=100
# FLUSH_INTERVAL=2
# HEARTBEAT_INTERVAL=30
# SPOOL_MAX_MB=50
# On the very first start the agent begins at the END of each log. Set this to also send the last N lines.
# BACKFILL_LINES=0

# --- TLS -------------------------------------------------------------------------------
# VERIFY_TLS=true
# SENTINELX_CA_BUNDLE=/path/to/internal-ca.pem
# Only for an isolated lab network without TLS:
# ALLOW_INSECURE=false
