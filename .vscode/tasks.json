{
  // Terminal > Run Task...  Run the two "install" tasks once, then "dev: backend + frontend".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: install",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
      "windows": { "command": "py -m venv .venv; .venv\\Scripts\\pip install -r requirements-dev.txt" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": ".venv/bin/uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "frontend: run",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev" }
    },
    {
      "label": "dev: backend + frontend",
      "dependsOn": ["backend: run", "frontend: run"],
      "problemMatcher": []
    },
    {
      "label": "test: backend",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: agent",
      "type": "shell",
      "command": "../backend/.venv/bin/python -m pytest -q",
      "windows": { "command": "..\\backend\\.venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/agent" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "frontend: type check",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "docker: start everything",
      "type": "shell",
      "command": "docker compose up --build",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
